# Contact form email delivery (Gmail SMTP).
# Without SMTP_USER / SMTP_PASS, form submissions are logged to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ganesh@alttredmiinds.com
# Google account -> Security -> 2-Step Verification -> App passwords (16 chars, no spaces).
SMTP_PASS=
CONTACT_TO_EMAIL=ganesh@alttredmiinds.com
# Optional. Gmail forces the authenticated mailbox as sender, so leave blank unless
# ganesh@alttredmiinds.com has this address configured as a verified "Send mail as" alias.
CONTACT_FROM_EMAIL=
